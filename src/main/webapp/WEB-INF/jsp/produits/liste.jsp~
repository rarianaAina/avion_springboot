<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html>
<head>
    <title>Liste des Produits</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="mb-6">
    <a href="/index.jsp" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded">
        Retour à l'accueil
    </a>
</div>
    <div class="container mt-4">
        <h2>Liste des Produits</h2>
        <div class="mb-3">
            <a href="/produits/nouveau" class="btn btn-primary">Nouveau Produit</a>
            <a href="/produits-conseil/nouveau" class="btn btn-success">Ajouter Produit du Mois</a>
        </div>

        <!-- Formulaire de recherche -->
        <div class="card mb-3">
            <div class="card-body">
                <form action="/produits" method="get" class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="nomProduit" class="form-control" 
                               placeholder="Rechercher un produit..." 
                               value="${param.nomProduit}">
                    </div>
                    <div class="col-md-4">
                        <select name="type" class="form-select">
                            <option value="">Tous les produits</option>
                            <option value="MOIS" ${param.type == 'MOIS' ? 'selected' : ''}>
                                Produits du mois
                            </option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Rechercher</button>
                    </div>
                </form>
            </div>
        </div>
        
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prix</th>
                    <th>Catégorie</th>
                    <th>Stock</th>
                    <th>Produit du Mois</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach items="${produits}" var="produit">
                    <tr>
                        <td>${produit.id}</td>
                        <td>${produit.nom}</td>
                        <td>${produit.prix}</td>
                        <td>${produit.categorie}</td>
                        <td>${produit.quantiteStock}</td>
                        <td>
                            <c:if test="${produit.produitDuMois != null}">
                                <span class="badge bg-success">
                                    ${produit.produitDuMois.mois} ${produit.produitDuMois.annee}
                                </span>
                            </c:if>
                        </td>
                        <td>
                            <a href="/produits/editer/${produit.id}" class="btn btn-sm btn-warning">Éditer</a>
                            <a href="/produits/supprimer/${produit.id}" class="btn btn-sm btn-danger" 
                               onclick="return confirm('Êtes-vous sûr ?')">Supprimer</a>
                        </td>
                    </tr>
                </c:forEach>
            </tbody>
        </table>
    </div>
</body>
</html>