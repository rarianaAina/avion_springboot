    @PostMapping("/modifier")
    public String modifierPrix(@RequestParam Long produitId, @RequestParam BigDecimal nouveauPrix) {
        Produit produit = produitService.getProduitById(produitId);
        BigDecimal ancienPrix = produit.getPrix();
        produit.setPrix(nouveauPrix);
        produitService.saveProduit(produit);
        historiquePrixService.enregistrerModification(produit, ancienPrix, nouveauPrix);
        return "redirect:/prix/edition";
    }

    @GetMapping("/historique")
